  },
  "runtimeRules": [
    "Do not render source/ear_training_moving_parts_master.png or the other master sheets.",
    "Do not bake exercise number, verdict, accuracy, counts, chord symbols, key names or MIDI state into artwork.",
    "The setup console is not visible during training; the compact bar replaces it and the room is preserved.",
    "The bar occupies the same design rectangle in both modes, so the console lifts away without the bar moving.",
    "Touch targets are inflated to a 48dp minimum around the drawn control's centre."
  ],
  "engineContract": {
    "viewModel": "com.harmonygates.eartraining.EarTrainingViewModel",
    "state": "EarTrainingUiState",
    "intents": [
      "Play",
      "Next",
      "Skip",
      "Restart",
      "StartTraining",
      "ExitToSetup",
      "ChooseFamily"
    ],
    "note": "Touch and MIDI both resolve into one StateFlow, so artwork state cannot drift from the exercise engine and switching modes does not restart a session.",
    "persistence": "Ear attempts are written through RecordedAttempts, which derives the ExerciseInstance the store requires. The attempt and verdict come from the capture and the evaluator, so they are the same evidence a chord gate stores."
  }
