<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      MIDI is the primary controller (00_README_START_HERE.md). The feature is declared as not
      required so the app still installs on a tablet that has no MIDI stack; the app detects
      support at runtime and says so, which 18_ACCEPTANCE_CRITERIA.md requires.
    -->
    <uses-feature
        android:name="android.software.midi"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HarmonyGates">

        <!--
          Landscape only, deliberately.

          Every approved frame is composed at 1536 x 1024, and the app is played sitting at a
          keyboard with the tablet propped in front of it. A portrait layout is not a narrower
          version of these screens, it is a different design that nobody has drawn: the piano
          keyboard, the progression track's perspective and the home artwork all assume the wide
          frame. Locking it is more honest than reflowing into something unapproved.

          Two lint checks are suppressed here, and only here. `LockedOrientationActivity` is the
          general advice to stay adaptive, which this app is deliberately not. `DiscouragedApi`
          warns that Android 16 ignores a fixed orientation on large screens — which is true, so
          this attribute is a request rather than a guarantee. `HarmonyLandscape` in the app
          enforces the same shape from inside the window, where the platform cannot overrule it.

          `adjustNothing` because the app has no text input worth resizing the window for. The
          controller is a MIDI keyboard; the only on-screen keyboard that can appear here is one
          nobody asked for, and letting it shrink the window would rescale a frame that is
          composed at a fixed 1536 x 1024 — which shows up as a screen that is inexplicably cut
          off down one side.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:theme="@style/Theme.HarmonyGates">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
