<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      MIDI is the primary controller (00_README_START_HERE.md). The feature is declared as not
      required so the app still installs on a tablet that has no MIDI stack; the app detects
      support at runtime and says so, which 18_ACCEPTANCE_CRITERIA.md requires.
    -->
    <uses-feature
        android:name="android.software.midi"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HarmonyGates">

        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_ORIENTATION"
            android:value="true" />

        <!--
          Landscape, locked. Every approved frame is composed at 1536x1024 and there is no
          portrait design, so the app does not follow the tablet: turning it sideways or upside
          down must not change what is on screen.

          targetSdk 36 is the complication. Android 16 ignores an activity's orientation request
          on large screens, which is how a portrait window reached this app at all. The
          PROPERTY_COMPAT_ALLOW_RESTRICTED_ORIENTATION property below opts back out of that
          change; it is honoured where the platform supports it and harmlessly ignored where it
          does not, so `landscape` is still the request and this is the thing that makes the
          platform respect it.

          Do not opt out of activity recreation for orientation/screen-size/density changes here.
          The activity contains saveable Compose state, and recreation is the reliable boundary
          when Android moves the app between full-screen, multi-window and differently sized task
          windows. Suppressing those configuration changes can leave an existing activity attached
          to window history that no longer matches the current launch.

          Likewise, use the default launch mode. This activity does not need singleTask semantics;
          reusing a previous task is specifically undesirable for a full-screen artwork surface,
          because that task may have retained freeform or multi-window bounds.

          adjustNothing is retained because the app has no text-input workflow that should resize
          the artwork around an IME.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:theme="@style/Theme.HarmonyGates">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
